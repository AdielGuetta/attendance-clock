{
  "Urls": "http://localhost:5080",
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "AllowRemoteClients": false,
  "ConnectionStrings": {
    "Attendance": "Server=localhost\\SQLEXPRESS;Database=Attendance;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Database": {
    "InitializeOnStartup": false
  },
  "TimeApi": {
    "AttemptTimeoutSeconds": 4,
    "AttemptsPerSource": 2,
    "RetryDelayMilliseconds": 250,
    "Sources": [
      { "Kind": "WorldTimeApi", "Url": "https://worldtime.timezone.io/api/timezone/Europe/Zurich" },
      { "Kind": "TimeApiIo", "Url": "https://timeapi.io/api/time/current/zone?timeZone=Europe/Zurich" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
